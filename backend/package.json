{
  "name": "waitt-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador del sistema WAItt: backend Node.js/TypeScript con API REST y WebSockets que reemplaza la lógica Arduino para desarrollo del frontend sin hardware.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "release": "commit-and-tag-version --config ../.versionrc.json",
    "release:dry": "commit-and-tag-version --config ../.versionrc.json --dry-run"
  },
  "commit-and-tag-version": {
    "scripts": {
      "prerelease": "pnpm.cmd run typecheck && pnpm.cmd run test && pnpm.cmd run build"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "commit-and-tag-version": "^13.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}