# Puerto HTTP + WebSocket del simulador
PORT=3000

# Intervalo del tick de simulación en milisegundos
TICK_MS=1000

# Número inicial de nodos servidor (workers) + 1 nodo general
INITIAL_NODES=3

# Temperaturas iniciales
INITIAL_TEMP=25
TARGET_TEMP=30
AMBIENT_TEMP=20

# Origen permitido por CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Capacidades de colas/pilas/log
NODE_QUEUE_CAPACITY=50
STACK_CAPACITY=20
LOG_CAPACITY=200

# Archivo de persistencia del log (JSONL; vacío desactiva la persistencia)
LOG_FILE=data/logs.jsonl

# Salida de logs por la consola del proceso (stdout/stderr)
LOG_CONSOLE=true
# Nivel mínimo de los eventos impresos en consola (info|warning|critical)
LOG_LEVEL=info
# Registra cada petición HTTP (método, ruta, status y duración)
LOG_HTTP=true
# Registra una línea de telemetría (temp por nodo + media) cada N ticks; 0 desactiva
LOG_TELEMETRY_EVERY=5

# Fallos consecutivos que marcan un nodo como error (semántica SensorReading del firmware)
MAX_CONSECUTIVE_FAILURES=5

# Capacidad del pool global de tareas pendientes (cola de prioridad, 1=menor, 5=mayor)
PENDING_POOL_CAPACITY=100

# Reglas reactivas cargadas al arranque
RULES_FILE=data/default-rules.json

# Base de datos time-series (MariaDB/MySQL vía Docker, ver docker-compose.yml)
# Activa el escritor de telemetría/eventos en el backend (println no-fatal si la BD no responde)
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=waitt
DB_USER=waitt
DB_PASSWORD=waitt
# Cada cuánto se vacía el buffer de filas hacia la BD
DB_FLUSH_MS=1000
# Tamaño máximo del buffer antes de forzar un flush
DB_MAX_BUFFER=1000
# DDL del esquema ejecutado al arrancar (fuente única con docker/mysql/init)
DB_SCHEMA_FILE=../docker/mysql/init/01-schema.sql

# Inferencia IA en proceso Node (worker Python persistente, ver ml/worker.py)
# Activa el servicio de inferencia automática integrado al EventBus
INFERENCE_ENABLED=true
# Horizonte de predicción en milisegundos (coincide con el del entrenamiento)
INFERENCE_HORIZON_MS=15000
# Intervalo mínimo entre inferencias por nodo
INFERENCE_THROTTLE_MS=500
# Timeout de respuesta del worker Python
INFERENCE_TIMEOUT_MS=2000
# Muestras mínimas en la ventana deslizante antes de inferir (lags t-1..t-8)
INFERENCE_MIN_SAMPLES=9
# Tamaño de la ventana deslizante por nodo
INFERENCE_WINDOW=25
# Intérprete Python del worker (ruta relativa a la raíz del repo o absoluta)
INFERENCE_PYTHON=ml/.venv/Scripts/python.exe

# Control automático de IA (lazo cerrado sobre las predicciones)
# Desactivado por defecto; se puede activar en caliente desde la UI/API
AI_CONTROL_ENABLED=false
# Umbrales de banda y confirmaciones
AI_CONTROL_HOT_DELTA=1.5
AI_CONTROL_COLD_DELTA=1.5
AI_CONTROL_RESTORE_DELTA=0.5
AI_CONTROL_CONFIRMATIONS=2
AI_CONTROL_COOLDOWN_MS=5000
AI_CONTROL_MAX_ACTIONS_PER_MIN=20
# Límites de carga
AI_CONTROL_LOAD_STEP=0.1
AI_CONTROL_LOAD_MIN=0.05
AI_CONTROL_LOAD_MAX=0.8
# Ajuste temporal del objetivo efectivo
AI_CONTROL_TARGET_MARGIN=1.5
AI_CONTROL_TARGET_STEP=0.5
# Tareas y apagado de emergencia
AI_CONTROL_TASK_INTERVAL_MS=15000
AI_CONTROL_EMERGENCY_DELTA=10
AI_CONTROL_RESTART_DELTA=2
AI_CONTROL_MIN_DOWNTIME_MS=30000
# Pausa tras detectar un cambio manual
AI_CONTROL_MANUAL_PAUSE_MS=30000
# Acciones habilitadas
AI_CONTROL_ALLOW_FAN=true
AI_CONTROL_ALLOW_LOAD=true
AI_CONTROL_ALLOW_TARGET=true
AI_CONTROL_ALLOW_TASKS=true
AI_CONTROL_ALLOW_SHUTDOWN=false
