# Puerto HTTP + WebSocket del simulador
PORT=3000

# Intervalo del tick de simulación en milisegundos
TICK_MS=1000

# Número inicial de nodos servidor (workers) + 1 nodo general
INITIAL_NODES=3

# Temperaturas iniciales
INITIAL_TEMP=25
TARGET_TEMP=30
AMBIENT_TEMP=20

# Origen permitido por CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Capacidades de colas/pilas/log
NODE_QUEUE_CAPACITY=50
STACK_CAPACITY=20
LOG_CAPACITY=200

# Archivo de persistencia del log (JSONL; vacío desactiva la persistencia)
LOG_FILE=data/logs.jsonl

# Salida de logs por la consola del proceso (stdout/stderr)
LOG_CONSOLE=true
# Nivel mínimo de los eventos impresos en consola (info|warning|critical)
LOG_LEVEL=info
# Registra cada petición HTTP (método, ruta, status y duración)
LOG_HTTP=true
# Registra una línea de telemetría (temp por nodo + media) cada N ticks; 0 desactiva
LOG_TELEMETRY_EVERY=5

# Fallos consecutivos que marcan un nodo como error (semántica SensorReading del firmware)
MAX_CONSECUTIVE_FAILURES=5

# Capacidad del pool global de tareas pendientes (cola de prioridad, 1=menor, 5=mayor)
PENDING_POOL_CAPACITY=100

# Reglas reactivas cargadas al arranque
RULES_FILE=data/default-rules.json